{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "himatch-backend",
  "main": "src/EntryPoint/index.ts",
  "compatibility_date": "2026-09-20",
  "workers_dev": false,
  "observability": {
    "traces": {
      "enabled": true
    }
  },
  "env": {
    "staging": {
      "name": "himatch-backend-staging",
      "triggers": { "crons": ["*/15 * * * *"] },
      "workers_dev": false,
      "routes": [
        {
          "pattern": "api-staging.beyond-labo.com",
          "custom_domain": true
        }
      ]
    },
    "production": {
      "name": "himatch-backend-production",
      "triggers": { "crons": ["*/15 * * * *"] },
      "workers_dev": false,
      "routes": [
        {
          "pattern": "api.beyond-labo.com",
          "custom_domain": true
        }
      ]
    }
  }
}
